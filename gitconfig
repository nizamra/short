# ============================================================================
#  nizamra/short — git config snippet
#  Append to ~/.gitconfig.
# ============================================================================

[user]
	email = nizam.jawabreh@gmail.com
	name = Nizam Rateb Aljawabreh

[alias]
	# --- basics ---
	c    = commit
	co   = checkout
	br   = branch
	s    = status
	ad   = add .
	d    = diff
	r    = reset

	# --- sync ---
	pl   = pull
	ps   = push

	# --- history ---
	cp     = cherry-pick
	copy = "! git format-patch eval `git log --oneline HEAD...release/4_5_0 | wc -l` HEAD"
	cls = "! git add .; git reset --hard"

	# --- log
	l    = log
	l1   = log --oneline
	lg   = log --oneline --graph --decorate --all
	last = log -1 HEAD

	# --- rewrite history (be careful on shared branches)
	# ama:    fold all tracked changes into the last commit, keep its message
	ama     = commit --amend -a --no-verify --no-edit
	# mk:     ama + push (force-with-lease refuses if someone else pushed meanwhile)
	mk      = "!git commit --amend -a --no-verify --no-edit && git push --force-with-lease"
	# pop:    undo the last commit, keep its changes in the working tree
	pop     = reset HEAD^
	# squash: git squash N folds the last N commits into the commit before them
	squash  = "!f() { git reset --soft HEAD~${1:-1} && git commit --amend --no-verify --no-edit; }; f"

[core]
	autocrlf = true

[filter "lfs"]
	required = true
	clean    = git-lfs clean -- %f
	smudge   = git-lfs smudge -- %f
	process  = git-lfs filter-process
[init]
	defaultBranch = master
